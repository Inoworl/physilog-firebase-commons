rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function hasTimestamps(data) {
      return data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function hasOptionalString(data, key) {
      return !data.keys().hasAny([key]) || data[key] is string;
    }

    function hasOptionalNullableTimestamp(data, key) {
      return !data.keys().hasAny([key])
        || data[key] == null
        || data[key] is timestamp;
    }

    function isSoftDeletedUpdate(data) {
      return data.keys().hasOnly(['deletedAt', 'updatedAt'])
        && data.deletedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasOptionalNumber(data, key) {
      return !data.keys().hasAny([key]) || data[key] is number;
    }

    function hasOptionalEnum(data, key, allowed) {
      return !data.keys().hasAny([key])
        || (data[key] is string && data[key] in allowed);
    }

    function hasOptionalListMax(data, key, maxSize) {
      return !data.keys().hasAny([key])
        || (data[key] is list && data[key].size() <= maxSize);
    }

    function isAthlete(data) {
      return data.keys().hasAll([
        'name',
        'createdAt',
        'updatedAt'
      ])
        && data.keys().hasOnly([
          'name',
          'age',
          'note',
          'deletedAt',
          'createdAt',
          'updatedAt'
        ])
        && isNonEmptyString(data.name)
        && hasOptionalNumber(data, 'age')
        && hasOptionalString(data, 'note')
        && hasOptionalNullableTimestamp(data, 'deletedAt')
        && hasTimestamps(data);
    }

    function isEvent(data) {
      return data.keys().hasAll([
        'name',
        'unit',
        'sortOrder',
        'createdAt',
        'updatedAt'
      ])
        && data.keys().hasOnly([
          'name',
          'unit',
          'recordType',
          'measurementMethod',
          'scoreDirection',
          'sortOrder',
          'deletedAt',
          'createdAt',
          'updatedAt'
        ])
        && isNonEmptyString(data.name)
        && isNonEmptyString(data.unit)
        && hasOptionalEnum(data, 'recordType', ['time', 'count', 'distance', 'weight'])
        && hasOptionalEnum(data, 'measurementMethod', ['video', 'manual'])
        && hasOptionalEnum(data, 'scoreDirection', ['higher', 'lower', 'none'])
        && data.sortOrder is number
        && hasOptionalNullableTimestamp(data, 'deletedAt')
        && hasTimestamps(data);
    }

    function isRecord(data) {
      return data.keys().hasAll([
        'athleteId',
        'eventId',
        'value',
        'athleteNameSnapshot',
        'eventNameSnapshot',
        'recordedAt',
        'createdAt',
        'updatedAt'
      ])
        && data.keys().hasOnly([
          'athleteId',
          'eventId',
          'value',
          'unit',
          'athleteNameSnapshot',
          'eventNameSnapshot',
          'recordedAt',
          'note',
          'startMs',
          'endMs',
          'durationMs',
          'videoRef',
          'fps',
          'sets',
          'createdAt',
          'updatedAt'
        ])
        && isNonEmptyString(data.athleteId)
        && isNonEmptyString(data.eventId)
        && hasOptionalString(data, 'unit')
        && isNonEmptyString(data.athleteNameSnapshot)
        && isNonEmptyString(data.eventNameSnapshot)
        && data.value is number
        && data.recordedAt is timestamp
        && hasOptionalString(data, 'note')
        && hasOptionalNumber(data, 'startMs')
        && hasOptionalNumber(data, 'endMs')
        && hasOptionalNumber(data, 'durationMs')
        && hasOptionalString(data, 'videoRef')
        && hasOptionalNumber(data, 'fps')
        && hasOptionalListMax(data, 'sets', 50)
        && hasTimestamps(data);
    }

    function isSupportedUserCollection(collectionId) {
      return collectionId == 'athletes'
        || collectionId == 'events'
        || collectionId == 'records';
    }

    function isValidUserDocument(collectionId, data) {
      return (collectionId == 'athletes' && isAthlete(data))
        || (collectionId == 'events' && isEvent(data))
        || (collectionId == 'records' && isRecord(data));
    }

    match /settings/appVersion {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;

      match /{collectionId}/{docId} {
        allow read, delete: if isOwner(userId)
          && isSupportedUserCollection(collectionId);
        allow create: if isOwner(userId)
          && isValidUserDocument(collectionId, request.resource.data);
        allow update: if isOwner(userId)
          && isSupportedUserCollection(collectionId)
          && (
            isValidUserDocument(collectionId, request.resource.data)
            || isSoftDeletedUpdate(request.resource.data)
          );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
