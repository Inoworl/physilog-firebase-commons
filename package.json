{
  "name": "physilog-firestore-commons",
  "version": "0.1.0",
  "private": true,
  "description": "Firestore Security Rules and shared schema contract for PhysiLog.",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "emulator:start": "firebase emulators:start --only firestore",
    "emulator:test": "firebase emulators:exec --only firestore --project demo-physilog-test \"npm test\"",
    "emulator:test:ci": "firebase emulators:exec --only firestore --project demo-physilog-test \"npm test -- --runInBand\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.13.0",
    "firebase-tools": "^14.7.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "maxWorkers": 1,
    "forceExit": true,
    "detectOpenHandles": true
  }
}
